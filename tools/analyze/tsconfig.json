{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM and no Node types: the core must run in Node and in the browser.
    // The CLI declares the few Node APIs it uses in src/cli/node.d.ts.
    "lib": ["ES2022"],
    "types": [],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "newLine": "lf"
  },
  "include": ["src"],
  // The page has the DOM lib: tsconfig.page.json.
  "exclude": ["src/page"]
}
