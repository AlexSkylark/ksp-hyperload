<Project Sdk="Microsoft.NET.Sdk">

  <!-- Assembly identity -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>TMinus</AssemblyName>
    <RootNamespace>TMinus</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Alessandro Arantes</Authors>
    <Copyright>Copyright (c) 2026 Alessandro Arantes</Copyright>
  </PropertyGroup>

  <!-- KSPBuildTools layout: the mod folder lives at <repo>/GameData/000_TMinus,
       compiled DLLs go to its Plugins subfolder. The 000_ prefix makes KSP load
       us early, so the profiler's Instantly addon runs before most others. -->
  <PropertyGroup>
    <TMinusModFolder>000_TMinus</TMinusModFolder>
    <KSPBT_ModRoot>$(MSBuildThisFileDirectory)../../GameData/$(TMinusModFolder)/</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- Harmony is provided at runtime by the HarmonyKSP mod (000_Harmony).
       Private=false: compile against it, never copy it to our output. -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(KSPBT_GameRoot)/GameData/000_Harmony/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Safety: only build against a KSP install that was chosen explicitly
       (KSPBT_GameRoot in TMinus.csproj.user, or the KSP_ROOT environment
       variable). Never let KSPBuildTools auto-discover one, and never touch a
       Steam install. -->
  <Target Name="TMinus_CheckGameRoot" BeforeTargets="ResolveReferences">
    <Error Condition="'$(KSPBT_GameRootSource)' != 'property' And '$(KSPBT_GameRootSource)' != 'environment variable'"
           Text="KSP install not set explicitly (found via '$(KSPBT_GameRootSource)': '$(KSPBT_GameRoot)'). Copy src/TMinus/TMinus.csproj.user.example to TMinus.csproj.user and set KSPBT_GameRoot to a dedicated dev install." />
    <Error Condition="$(KSPBT_GameRoot.ToLowerInvariant().Contains('steamapps'))"
           Text="Refusing to build against a Steam install: '$(KSPBT_GameRoot)'. Use a separate copy of KSP for development." />
    <Message Importance="high" Text="T-Minus: building against KSP install at $(KSPBT_GameRoot)" />
  </Target>

  <!-- Version stamp: the SDK appends the commit to InformationalVersion
       (0.1.0+<sha>). Mark a build from uncommitted source as <sha>.dirty, so
       a run's version never names code it does not carry. -->
  <Target Name="TMinus_MarkDirtySource" AfterTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain -- ." WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TMinusGitStatus" />
    </Exec>
    <PropertyGroup Condition="'$(_TMinusGitStatus)' != ''">
      <SourceRevisionId>$(SourceRevisionId).dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Deploy: mirror <repo>/GameData/000_TMinus into the dev install's GameData
       after KSPBuildTools has copied the DLL there -->
  <Target Name="TMinus_DeployToGame" AfterTargets="KSPBT_CopyDLLsToPluginFolder">
    <ItemGroup>
      <_TMinusModFiles Include="$(KSPBT_ModRoot)**/*" Exclude="$(KSPBT_ModRoot)**/.gitkeep" />
    </ItemGroup>
    <Copy SourceFiles="@(_TMinusModFiles)"
          DestinationFolder="$(KSPBT_GameRoot)/GameData/$(TMinusModFolder)/%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="T-Minus: deployed to $(KSPBT_GameRoot)/GameData/$(TMinusModFolder)" />
  </Target>

</Project>
